-- Usage: change the output controlling focus from CameraFocus to the camera's script function
--        but assign CameraFocus to any other "Disabled" channel as we need to read it, as it allows fine-tuning
-- A Scripting camera (CAMn_TYPE 7, ArduSub 4.8+) reads its zoom and focus from its own camera
-- state instead, and this script also drives its zoom and focus input outputs. Its focus output
-- is on no function ("Disabled"): the script drives it by its channel, and hands it over to the
-- manager's Focus now on a lease (below).

-- ArduPilot's camera library (the cameras below are also called `camera`)
local ap_camera = camera

-- The cameras this script serves
local CAMERAS = {
{% for camera in cameras %}    {
        id = {{ camera.id }},
        -- Unique key (0-200). Must not conflict with other scripts
        param_table_key = {{ camera.param_table_key }},
        -- Prefix for all parameter names in this table
        param_prefix = {{ camera.param_prefix }},
        margin_gain = {{ camera.margin_gain }},
        k_script = {{ camera.k_script }},
        script_function_name = "{{ camera.script_function_name }}",
        focus_ch = {{ camera.focus_ch }},
        k_zoom = {{ camera.k_zoom }},
        k_focus_input = {{ camera.k_focus_input }},
        zoom_name = "{{ camera.zoom_name }}",
        focus_input_name = "{{ camera.focus_input_name }}",
        -- Lookup tables for closest and furthest focus points
        closest_points = {{ camera.closest_points }},
        furthest_points = {{ camera.furthest_points }},
    },
{% endfor %}}

for _, camera in ipairs(CAMERAS) do
    -- Add parameter table with N parameters
    assert(param:add_table(camera.param_table_key, camera.param_prefix, 2), 'could not add param table')

    -- Define parameters with index (1-63), name, and default value
    assert(param:add_param(camera.param_table_key, 1, "ENABLE", 1), 'could not add ENABLE')
    assert(param:add_param(camera.param_table_key, 2, "GAIN", camera.margin_gain), 'could not add GAIN')

    -- Initialize parameter objects
    camera.ENABLE = Parameter()      -- when false, this bypasses the correlation
    camera.GAIN = Parameter() -- this will allow us to move 5% beyeond closest/furthest focus lines, useful for making a new curve

    -- Bind them to physical parameter locations
    assert(camera.ENABLE:init(camera.param_prefix .. "ENABLE"), "Failed to init ENABLE")
    assert(camera.GAIN:init(camera.param_prefix .. "GAIN"), "Failed to init GAIN")

    assert(#camera.closest_points >= 2, "closest_points requires at least 2 points")
    assert(#camera.furthest_points >= 2, "furthest_points requires at least 2 points")

    camera.missing_script_warned = { false }
end

--- Constants
local K_FOCUS = 92
local K_ZOOM = 180
local MAV_SEVERITY_WARNING = 4
local SCRIPTING_CAMERA_TYPE = 7
-- camera_state_t zoom_type and focus_type (0 until the camera is first commanded)
local STATE_RATE, STATE_PCT = 1, 2
local DEFAULT_RATE_PCT_PER_S = 5
-- A longer gap between two runs is not integrated, so a stalled script does not jump
local MAX_STEP_S = 1.0

local missing_focus_warned = { false }
local missing_zoom_warned = { false }

local function warn_missing_servo_function(function_name, warned_flag)
    if warned_flag[1] then
        return
    end

    gcs:send_text(MAV_SEVERITY_WARNING, "4K Cam: " .. function_name .. " servo function not found")
    warned_flag[1] = true
end

local function find_servo_function(function_id, function_name, warned_flag)
    local channel = SRV_Channels:find_channel(function_id)
    if channel == nil then
        warn_missing_servo_function(function_name, warned_flag)
    end

    return channel
end

-- The MIN, MAX and TRIM of the servo a function is on, or nil
local function find_servo_range(function_id, function_name, warned_flag)
    local channel = find_servo_function(function_id, function_name, warned_flag)
    if channel == nil then return nil end
    local min = param:get("SERVO" .. channel + 1 .. "_MIN")
    local max = param:get("SERVO" .. channel + 1 .. "_MAX")
    local trim = param:get("SERVO" .. channel + 1 .. "_TRIM")
    if min == nil or max == nil or trim == nil or max <= min then return nil end
    return { min = min, max = max, trim = trim }
end

local function is_scripting_camera(camera)
    return param:get("CAM" .. camera.id .. "_TYPE") == SCRIPTING_CAMERA_TYPE
end

-- Focus now lease: COMMAND_LONG MAV_CMD_USER_1 to the autopilot, for the camera with that id.
--   param1 camera id, param2 mode (1 hold, which also renews it; 0 release), param4 lease ms.
-- While it is held the script does not write the camera's focus output, and the manager drives
-- it with DO_SET_SERVO. Otherwise the script holds the output with an override, so a
-- DO_SET_SERVO from anyone has no effect (it is still ACKed ACCEPTED).
-- The lease ends on a release or when it is not renewed in time (the manager is gone): the
-- focus stays where it was left, the input taking the value that gives it until the camera's
-- focus is commanded again. The user commanding the focus or the zoom ends it at once and their
-- command wins; holds are then DENIED until a release.
-- COMMAND_ACK: result ACCEPTED (0) or DENIED (2); result_param2 = focus output | (zoom << 16).
local MAV_CMD_USER_1 = 31010
local COMMAND_LONG_ID = 76
local COMMAND_ACK_ID = 77
local RESULT_ACCEPTED, RESULT_DENIED = 0, 2
local MAV_SEVERITY_INFO = 6
local TICK_MS = 100
local USER_MOVE_US = 4 -- a focus input change this big is the user's command

-- The binding's receive queue is the autopilot's, shared by every script and sized by the first
-- one to ask, so this script registers once for all its cameras. Without the binding there is
-- no lease, and Focus now gets no answer.
local lease_available = mavlink ~= nil and pcall(function()
    -- (queue depth 10, 1 message id)
    mavlink:init(10, 1)
    -- False when this script already registered it before a scripting restart, which keeps
    -- the registration: fine.
    mavlink:register_rx_msgid(COMMAND_LONG_ID)
    assert(mavlink:block_command(MAV_CMD_USER_1))
end)

-- The lease commands since the last run, by the camera id they name.
local function receive_commands()
    local inboxes = {}
    while lease_available do
        local msg, chan = mavlink:receive_chan()
        if msg == nil then break end
        -- mavlink_message_t: the system id at byte 8, then the component id, the 24-bit message
        -- id and the payload, packed from byte 9 or spread out by the build (the Navigator's
        -- ArduSub 4.8: component id at byte 12, message id at 13, payload from 16)
        local id_at = msg:find(string.pack("<I3", COMMAND_LONG_ID), 10, true) or 10
        local p1, p2, _, p4, _, _, _, cmd = string.unpack("<fffffffH", msg, id_at + 3)
        if cmd == MAV_CMD_USER_1 then
            local id = math.floor(p1 + 0.5)
            local sysid, compid = msg:byte(8), msg:byte(id_at - 1)
            inboxes[id] = inboxes[id] or {}
            table.insert(inboxes[id], { mode = math.floor(p2 + 0.5), ms = p4, chan = chan, sysid = sysid, compid = compid })
        end
    end
    return inboxes
end

-- Function to set focus and zoom to trim level
local function set_zoom_focus_to_trim(camera)
    local focus_channel = find_servo_function(K_FOCUS, "CameraFocus", missing_focus_warned)
    if focus_channel == nil then return false end
    local focus_max = param:get("SERVO" .. focus_channel + 1 .. "_MAX")
    local focus_min = param:get("SERVO" .. focus_channel + 1 .. "_MIN")
    local focus_trim = param:get("SERVO" .. focus_channel + 1 .. "_TRIM")
    if focus_max == nil or focus_min == nil or focus_trim == nil then return false end
    local focus_scaled = 1000 * (focus_trim - focus_min) / (focus_max - focus_min)
    SRV_Channels:set_output_scaled(K_FOCUS, focus_scaled)

    local zoom_channel = find_servo_function(K_ZOOM, "CameraZoom", missing_zoom_warned)
    if zoom_channel == nil then return false end
    local zoom_max = param:get("SERVO" .. zoom_channel + 1 .. "_MAX")
    local zoom_min = param:get("SERVO" .. zoom_channel + 1 .. "_MIN")
    local zoom_trim = param:get("SERVO" .. zoom_channel + 1 .. "_TRIM")
    if zoom_max == nil or zoom_min == nil or zoom_trim == nil then return false end
    local zoom_scaled = 1000 * (zoom_trim - zoom_min) / (zoom_max - zoom_min)
    SRV_Channels:set_output_scaled(K_ZOOM, zoom_scaled)

    local script_channel = find_servo_function(camera.k_script, camera.script_function_name, camera.missing_script_warned)
    if script_channel == nil then return false end
    local script_trim = param:get("SERVO" .. script_channel + 1 .. "_TRIM")
    if script_trim == nil then return false end
    SRV_Channels:set_output_pwm(camera.k_script, script_trim)

    return true
end

-- Linear interpolation function
local function lerp(x, x1, y1, x2, y2)
    return y1 + (x - x1) * (y2 - y1) / (x2 - x1)
end

-- Function to interpolate focus value from lookup table
local function interpolate_focus(zoom, points)
    -- Handle edge cases
    if zoom <= points[1].zoom then
        return points[1].focus
    end
    if zoom >= points[#points].zoom then
        return points[#points].focus
    end

    -- Find the bracketing points
    for i = 1, #points - 1 do
        if zoom >= points[i].zoom and zoom < points[i + 1].zoom then
            return lerp(zoom,
                points[i].zoom, points[i].focus,
                points[i + 1].zoom, points[i + 1].focus)
        end
    end

    return points[#points].focus -- fallback
end

-- Function to calculate focus position based on zoom position
local function calculate_focus(camera, focus, zoom, margin_gain)
    -- Interpolate both closest and furthest focus values
    local closest_focus = interpolate_focus(zoom, camera.closest_points)
    local furthest_focus = interpolate_focus(zoom, camera.furthest_points)

    -- Linear interpolation between closest and furthest based on focus_delta
    local focus_delta = 0.5 + (focus - 1500) / 400
    -- local focus_delta = math.min(1.0, math.max(0.0, 0.5 + (focus - 1500) / 400))
    local range = (furthest_focus - closest_focus) * margin_gain
    local mid_point = closest_focus + range / 2
    return math.floor(mid_point + (focus_delta - 0.5) * range)
end

local function clamp(value, min, max)
    return math.min(max, math.max(min, value))
end

-- The next PWM of an output from what its camera was last commanded: a percentage is the
-- target, a rate (-1 to 1 of `rate_pct_per_s`) moves it over `dt` seconds
local function follow(pwm, kind, value, range, rate_pct_per_s, dt)
    if value ~= value then return pwm end -- NaN
    local span = range.max - range.min
    if kind == STATE_PCT then
        return range.min + clamp(value, 0, 100) * span / 100
    elseif kind == STATE_RATE then
        return clamp(pwm + clamp(value, -1, 1) * rate_pct_per_s * span / 100 * dt, range.min, range.max)
    end
    return pwm
end

-- Where an output is, or its trim when it has none yet: a script restart keeps the position
local function current_pwm(function_id, range)
    local pwm = SRV_Channels:get_output_pwm(function_id)
    if pwm == nil or pwm < range.min or pwm > range.max then return range.trim end
    return pwm
end

-- The input whose focus output is nearest `pwm`, of the ones next to the exact inverse of
-- `calculate_focus` (a search over the whole range would cost too many Lua instructions).
local function input_for(camera, pwm, zoom_input, margin_gain, correlation, range)
    if not correlation then return clamp(pwm, range.min, range.max) end
    local closest = interpolate_focus(zoom_input, camera.closest_points)
    local span = (interpolate_focus(zoom_input, camera.furthest_points) - closest) * margin_gain
    if span == 0 then return clamp(1500, range.min, range.max) end
    local guess = math.floor(1500 + (pwm - closest - span / 2) * 400 / span + 0.5)
    local best
    for input = guess - 2, guess + 2 do
        local candidate = clamp(input, range.min, range.max)
        if best == nil or math.abs(calculate_focus(camera, candidate, zoom_input, margin_gain) - pwm)
            < math.abs(calculate_focus(camera, best, zoom_input, margin_gain) - pwm) then
            best = candidate
        end
    end
    return best
end

-- A Scripting camera: its zoom and focus come from its own camera state, and `inbox` holds its
-- lease commands
local function update_scripting_camera(camera, dt, inbox)
    local zoom_range = find_servo_range(camera.k_zoom, camera.zoom_name, camera.missing_script_warned)
    local input_range = find_servo_range(camera.k_focus_input, camera.focus_input_name, camera.missing_script_warned)
    if zoom_range == nil or input_range == nil then
        return
    end
    camera.zoom_input = camera.zoom_input or current_pwm(camera.k_zoom, zoom_range)
    camera.focus_input = camera.focus_input or current_pwm(camera.k_focus_input, input_range)

    local state = ap_camera and ap_camera:get_state(camera.id - 1)
    if state ~= nil then
        local zoom_rate = param:get("CAM" .. camera.id .. "_ZOM_RAT_MAX") or DEFAULT_RATE_PCT_PER_S
        local focus_rate = param:get("CAM" .. camera.id .. "_FOC_RAT_MAX") or DEFAULT_RATE_PCT_PER_S
        camera.zoom_input = follow(camera.zoom_input, state:zoom_type(), state:zoom_value(), zoom_range, zoom_rate, dt)
        -- A focus a lease left stays until the camera's focus is commanded again.
        local adopted = camera.adopted
        if adopted and (adopted[1] ~= state:focus_type() or adopted[2] ~= state:focus_value()) then
            camera.adopted = nil
        end
        if not camera.adopted then
            camera.focus_input = follow(camera.focus_input, state:focus_type(), state:focus_value(), input_range, focus_rate, dt)
        end
    end
    local zoom_input = math.floor(camera.zoom_input + 0.5)
    local focus_input = math.floor(camera.focus_input + 0.5)

    -- Retrieve values from parameters
    local enable_focus_and_zoom_correlation = camera.ENABLE:get()
    local margin_gain = camera.GAIN:get()
    if enable_focus_and_zoom_correlation == nil or margin_gain == nil then
        return
    end

    -- Computes the output focus, and the range the focus slider covers at this zoom
    local focus_output, focus_min, focus_max
    if enable_focus_and_zoom_correlation ~= 0 then
        focus_output = calculate_focus(camera, focus_input, zoom_input, margin_gain)
        focus_min = calculate_focus(camera, input_range.min, zoom_input, margin_gain)
        focus_max = calculate_focus(camera, input_range.max, zoom_input, margin_gain)
        focus_min, focus_max = math.min(focus_min, focus_max), math.max(focus_min, focus_max)
    else
        focus_output, focus_min, focus_max = focus_input, input_range.min, input_range.max
    end

    -- The lease. The user commanding the focus or the zoom ends it, their command wins.
    local now = millis():tofloat()
    local lease = camera.lease
    if lease and (math.abs(focus_input - lease.focus_input) > USER_MOVE_US or zoom_input ~= lease.zoom_input) then
        camera.lease, camera.denied, lease = nil, true, nil
    end
    local current = SRV_Channels:get_output_pwm_chan(camera.focus_ch) or focus_output
    local acks = {}
    for _, command in ipairs(inbox) do
        local result = RESULT_ACCEPTED
        if command.mode == 1 and camera.denied then
            result = RESULT_DENIED
        elseif command.mode == 1 then
            if lease == nil then
                -- Off the override, keeping the output where it is: the manager's DO_SET_SERVO
                -- takes effect from now on.
                SRV_Channels:set_output_pwm_chan_timeout(camera.focus_ch, current, 0)
                lease = { focus_input = focus_input, zoom_input = zoom_input }
                camera.lease = lease
            end
            lease.until_ms, lease.released = now + clamp(command.ms, TICK_MS, 3000), nil
        else
            camera.denied = false
            if lease then lease.released = true end
        end
        acks[#acks + 1] = { command, result }
    end
    -- Released, not renewed in time, or driven out of the slider's range: the focus stays where
    -- it was left (within that range).
    local outside = current < focus_min or current > focus_max
    if lease and (lease.released or now > lease.until_ms or outside) then
        local reason = outside and "out of range" or (lease.released and "released" or "expired")
        camera.lease, camera.denied = nil, outside
        local pwm = clamp(current, focus_min, focus_max)
        if math.abs(pwm - focus_output) > 1 then
            focus_input = input_for(camera, pwm, zoom_input, margin_gain, enable_focus_and_zoom_correlation ~= 0, input_range)
            camera.focus_input = focus_input
            camera.adopted = state and { state:focus_type(), state:focus_value() } or { 0, 0 }
            focus_output = enable_focus_and_zoom_correlation ~= 0
                and calculate_focus(camera, focus_input, zoom_input, margin_gain) or focus_input
        end
        if reason ~= "released" then
            gcs:send_text(MAV_SEVERITY_INFO, string.format("4K Cam: camera %d focus lease %s, focus kept at %d", camera.id, reason, focus_output))
        end
    end

    SRV_Channels:set_output_pwm(camera.k_zoom, zoom_input)
    SRV_Channels:set_output_pwm(camera.k_focus_input, focus_input)
    if camera.lease == nil then
        -- Forced, so a DO_SET_SERVO from anyone has no effect until the next run renews it;
        -- it outlasts a late run, where the output keeps its last value anyway.
        SRV_Channels:set_output_pwm_chan_timeout(camera.focus_ch, focus_output, 2 * TICK_MS + 50)
    end
    for _, ack in ipairs(acks) do
        local command, result = ack[1], ack[2]
        local focus = camera.lease and current or focus_output
        -- COMMAND_ACK: command, result, progress, result_param2 (focus | zoom << 16), target
        mavlink:send_chan(command.chan, COMMAND_ACK_ID,
            string.pack("<HBBiBB", MAV_CMD_USER_1, result, 0, focus | (zoom_input << 16), command.sysid, command.compid))
    end
end

-- A Servo camera: its zoom and focus come from ArduPilot's one CameraZoom and CameraFocus.
-- A focus function already written in this run (`written`) is left alone.
local function update_servo_camera(camera, written)
    if written[camera.k_script] then
        return
    end

    -- Retrieve values from parameters
    local enable_focus_and_zoom_correlation = camera.ENABLE:get()
    local margin_gain = camera.GAIN:get()

    -- Retrieve user-controlled focus and zoom
    local focus_input = SRV_Channels:get_output_pwm(K_FOCUS)
    local zoom_input = SRV_Channels:get_output_pwm(K_ZOOM)

    if focus_input == nil then
        warn_missing_servo_function("CameraFocus", missing_focus_warned)
    end

    if zoom_input == nil then
        warn_missing_servo_function("CameraZoom", missing_zoom_warned)
    end

    if enable_focus_and_zoom_correlation == nil or margin_gain == nil
        or focus_input == nil or zoom_input == nil then
        return
    end

    -- Computes the output focus
    local focus_output
    if enable_focus_and_zoom_correlation ~= 0 then
        focus_output = calculate_focus(camera, focus_input, zoom_input, margin_gain)
    else
        focus_output = focus_input
    end

    -- Apply zoom to the output
    SRV_Channels:set_output_pwm(camera.k_script, focus_output)
    written[camera.k_script] = true
end

local last_ms

function start()
    if millis() <= 100000 then
        local trimmed = {}
        for _, camera in ipairs(CAMERAS) do
            if not is_scripting_camera(camera) and not trimmed[camera.k_script] then
                set_zoom_focus_to_trim(camera)
                trimmed[camera.k_script] = true
            end
        end
    end
    return update, 100
end

function update()
    local now_ms = millis():tofloat()
    local dt = last_ms and clamp((now_ms - last_ms) / 1000, 0, MAX_STEP_S) or 0
    last_ms = now_ms

    -- CAMn_TYPE as stored: a new type takes effect at the next boot, until then the camera holds.
    -- A Servo camera never writes a function a Scripting camera owns.
    local scripting, written = {}, {}
    for _, camera in ipairs(CAMERAS) do
        scripting[camera] = is_scripting_camera(camera)
        if scripting[camera] then
            written[camera.k_zoom], written[camera.k_focus_input] = true, true
        end
    end

    local inboxes = receive_commands()
    for _, camera in ipairs(CAMERAS) do
        if scripting[camera] then
            update_scripting_camera(camera, dt, inboxes[camera.id] or {})
        else
            update_servo_camera(camera, written)
        end
    end

    return update, TICK_MS
end

return start, 1000
